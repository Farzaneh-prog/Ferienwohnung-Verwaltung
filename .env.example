# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Login (single admin user)
ADMIN_USERNAME=admin
# Generate a hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Optional: override where the reservation Excel files live.
# Defaults to the project root (same folder as this .env file).
# DATA_DIR=E:\Gemeinsam\Ferienwohnung\Automat

# Checkin reminder emails (app/checkin_reminder.py) — sent immediately when
# a new reservation is added, with a .ics calendar alarm for 16:00 the day
# before check-in. Uses a Gmail App Password, NOT your normal Gmail password:
# Google Account -> Security -> 2-Step Verification -> App Passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who receives the reminder. Defaults to GMAIL_USER itself, but the iOS
# Gmail app does not offer "Add to Calendar" for .ics attachments (confirmed
# 2026-09-25) — point this at an address you check with Apple's native Mail
# app instead (that's what actually adds the calendar alarm).
NOTIFY_TO_EMAIL=

# WhatsApp cleaner coordination (phase 3, app/cleaner_coordination.py +
# app/whatsapp_sender.py). Account SID/Auth Token from the Twilio Console
# dashboard. TWILIO_WHATSAPP_FROM defaults to the shared Sandbox number
# (+14155238886) if left blank — only set it once a dedicated production
# number exists.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# ContentSid of the cleaner-request template (created via the Content API —
# see docs/STATUS.md section 14). Not secret, but only ever read from here.
# TWILIO_CLEANER_TEMPLATE_SID=

# Your own WhatsApp number (E.164, e.g. +4915112345678) — used ONLY by the
# one-off tools/test_whatsapp_send.py smoke test, to send a real Sandbox
# message to yourself before testing against actual cleaners.
NOTIFY_TEST_WHATSAPP_NUMBER=
